{
  "name": "project-root",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently --kill-others --names server,web \"bun --cwd apps/server dev\" \"bun --cwd apps/web dev\"",
    "build": "bun --filter \"*\" build",
    "typecheck": "bun --filter \"*\" typecheck",
    "test": "bun test apps/server/src",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "@playwright/test": "^1.55.0"
  }
}
