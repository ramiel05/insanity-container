{
  "name": "@proj/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#db": "./src/db/index.ts",
    "#db/*": "./src/db/*",
    "#routes/*": "./src/routes/*"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "bun test src",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/backend": "^3.17.2",
    "@hono/zod-validator": "^0.7.2",
    "@libsql/client": "^0.18.0",
    "@proj/shared": "workspace:*",
    "drizzle-orm": "^0.44.5",
    "hono": "^4.9.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bun": "^1.4.1",
    "drizzle-kit": "^0.31.4",
    "typescript": "^7.0.2"
  }
}
