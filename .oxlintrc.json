{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true
  },
  "plugins": ["typescript", "react", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "restriction": "error"
  },
  "rules": {
    "typescript/prefer-readonly-parameter-types": [
      "error",
      {
        "ignoreInferredTypes": true,
        "allow": [
          {
            "from": "lib",
            "name": "Response"
          },
          {
            "from": "lib",
            "name": "Request"
          },
          {
            "from": "lib",
            "name": "RequestInit"
          },
          {
            "from": "package",
            "name": "ZodType",
            "package": "zod"
          },
          {
            "from": "lib",
            "name": "Error"
          },
          {
            "from": "lib",
            "name": "ReactNode"
          },
          {
            "from": "package",
            "name": "UseQueryResult",
            "package": "@tanstack/react-query"
          },
          {
            "from": "package",
            "name": "UseMutationResult",
            "package": "@tanstack/react-query"
          },
          {
            "from": "package",
            "name": "QueryClient",
            "package": "@tanstack/react-query"
          },
          {
            "from": "package",
            "name": "QueryClient",
            "package": "@tanstack/query-core"
          },
          {
            "from": "package",
            "name": "ReactNode",
            "package": "react"
          }
        ]
      }
    ],
    "react/jsx-filename-extension": [
      "error",
      {
        "extensions": ["jsx", "tsx"]
      }
    ],
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css", "**/*.scss"]
      }
    ],
    "react/forbid-component-props": [
      "error",
      {
        "forbid": ["style"]
      }
    ],
    "no-void": [
      "error",
      {
        "allowAsStatement": true
      }
    ],
    "react/react-in-jsx-scope": "off",
    "max-lines-per-function": "off"
  },
  "overrides": [
    {
      "files": ["**/{playwright,vite,astro,drizzle}.config.*", "tests/browser/global-setup.ts"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["apps/web/src/lib/api.ts"],
      "rules": {
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/prefer-readonly-parameter-types": "off",
        "no-undefined": "off"
      }
    },
    {
      "files": ["apps/web/src/lib/hooks.ts", "apps/web/src/lib/star-hooks.ts"],
      "rules": {
        "no-undefined": "off"
      }
    },
    {
      "files": ["apps/server/src/auth.ts"],
      "rules": {
        "typescript/promise-function-async": "off"
      }
    },
    {
      "files": ["tests/browser/auth.ts"],
      "rules": {
        "react-hooks/rules-of-hooks": "off",
        "typescript/prefer-readonly-parameter-types": "off"
      }
    },
    {
      "files": ["apps/server/src/index.ts", "apps/server/src/routes/*.ts"],
      "rules": {
        "typescript/explicit-function-return-type": "off",
        "typescript/explicit-module-boundary-types": "off"
      }
    }
  ]
}
